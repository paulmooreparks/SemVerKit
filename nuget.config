<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-scoped NuGet config. Declares a wildcard source mapping for
  nuget.org so contributors with a strict user-profile packageSourceMapping
  (an explicit allowlist of package IDs) can still restore this repo's
  dependencies without touching their profile. nuget.org is the only
  configured source; the wildcard does not add any trust surface.

  Inner-loop dev across the sibling Overt repo: when iterating on Overt's
  compiler/back-end and consuming the build here, layer a per-clone
  override config that points at `..\Overt\dist`. Don't add the local
  source here. NuGet errors NU1301 when the directory is absent on a
  fresh clone (notably on CI runners), and the local feed is a personal
  dev convenience, not a project-wide one.

  See README §Releasing for the per-clone override-config recipe.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
