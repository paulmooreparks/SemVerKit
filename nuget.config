<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-scoped NuGet config. Declares a wildcard source mapping for
  nuget.org so contributors with a strict user-profile packageSourceMapping
  (an explicit allowlist of package IDs) can still restore this repo's
  dependencies without touching their profile.

  The "overt-local" source picks up locally-packed Overt.Build builds out
  of the sibling Overt repo's dist/ directory; it's harmless when that
  directory is absent (NuGet skips missing sources). All non-Overt
  packages route to nuget.org via the wildcard.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="overt-local" value="..\Overt\dist" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="overt-local">
      <package pattern="Overt*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
